DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
# Required when running behind a reverse proxy / non-default host (self-hosting).
AUTH_TRUST_HOST="true"
TOKEN_ENCRYPTION_KEY="change-me-to-a-32-byte-secret-key"

# Optional: enables real LLM-backed contract reading and a smarter AI assistant.
# Without it the app falls back to a deterministic, rule-based analyzer.
ANTHROPIC_API_KEY=""

# Optional: official Kazakhstan e-procurement portal (goszakupki.gov.kz) API.
# Without these the Tenders module works fully in manual-entry / document-upload mode.
GOSZAKUPKI_API_BASE=""
GOSZAKUPKI_API_TOKEN=""

# Optional: enables Web Push notifications (payment/deadline reminders as OS notifications).
# Generate a pair with `npx web-push generate-vapid-keys`. Without these, notifications
# still work inside the app (bell icon / Задачи), just not as browser push.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@koshelek.online"
